# Workflow settings for Nokia XG-040G-TF PonWrt builds.
# Change this file for normal builds; the workflow only exposes force_build.

PONWRT_REPO="https://github.com/pbs05/ponwrt.git"
PONWRT_REF="master"

# Space-separated package names. Prefix a package with '-' to remove it.
EXTRA_PACKAGES=""

# Full target-compatible kmod bundle and GitHub Release are enabled by default.
INCLUDE_ALL_KMODS="true"
PUBLISH_RELEASE="true"
RELEASE_PREFIX="xg-040g-tf-ponwrt"
