# Workflow settings for Nokia XG-040G-TF PonWrt builds.
# Change this file for normal builds; the workflow only exposes force_build.

PONWRT_REPO="https://github.com/pbs05/ponwrt.git"
PONWRT_REF="master"

# Feed heads are checked daily so plugin-only updates also produce a build.
PONWRT_FEEDS=(
  "packages=https://github.com/immortalwrt/packages.git"
  "luci=https://github.com/immortalwrt/luci.git"
  "routing=https://github.com/openwrt/routing.git"
  "telephony=https://github.com/openwrt/telephony.git"
  "video=https://github.com/openwrt/video.git"
  "pon_drivers=https://github.com/pbs05/openwrt-pon-drivers.git"
  "pon_userspace=https://github.com/pbs05/openwrt-pon-userspace.git"
)

# Space-separated package names. Prefix a package with '-' to remove it.
EXTRA_PACKAGES=""

# Full target-compatible kmod/package bundles and GitHub Release are enabled by default.
# These kmods are excluded from CONFIG_ALL_KMODS when the current PonWrt
# kernel tree cannot compile them. Keep this list limited to package names.
EXCLUDE_KMODS="kmod-ipt-rtpengine"
INCLUDE_ALL_KMODS="true"
INCLUDE_ALL_PACKAGES="true"
USE_CCACHE="true"
PUBLISH_RELEASE="true"
RELEASE_PREFIX="xg-040g-tf-ponwrt"
